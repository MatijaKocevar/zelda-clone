{
    "name": "zelda-clone",
    "homepage": "https://matijakocevar.github.io/zelda-clone",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings=-1",
        "certs": "bash scripts/make-certs.sh",
        "preview": "vite preview",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "phaser": "^3.70.0",
        "sass": "^1.70.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.15",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "eslint": "^8.55.0",
        "gh-pages": "^6.1.1",
        "typescript": "^5.2.2",
        "vite": "^7.0.5",
        "vite-plugin-mkcert": "^1.17.3",
        "vite-plugin-pwa": "^1.0.1"
    }
}
